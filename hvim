#!/bin/bash

readonly folder_name="$(realpath . |tr '/' '_')"
readonly sessions_dir="$HOME/.nvim-sessions"
readonly socket="$sessions_dir/$folder_name.sock"

mkdir -p "$sessions_dir"

# Start a background nvim server the first time a session is opened in this
# folder. Subsequent invocations just attach a UI to the existing server.
if ! nvim --server "$socket" --remote-expr '1' &>/dev/null; then
  # macOS (BSD userland) has no `setsid` binary, unlike Linux. Use Python's
  # os.setsid() (via the uv-managed interpreter, so no extra dependency is
  # needed) to detach into a new session, then exec into nvim so it replaces
  # the python process and keeps the same PID.
  uv run --with neovim-remote --with pyright --with salt-lint --with flake8 --with pylint --no-project \
    python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' \
    nvim --listen "$socket" &>/dev/null </dev/null &
  disown

  # Wait for the server socket to come up before attaching.
  for _ in $(seq 1 50); do
    [ -S "$socket" ] && break
    sleep 0.1
  done
fi

# Attach a UI to the (possibly newly spawned) server. Closing this terminal
# detaches the UI without killing the background nvim server; only quitting
# from within nvim (:qa) stops the session.
exec nvim --server "$socket" --remote-ui

